---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} Sem Narrativa. Todos os direitos reservados.</p>
	<nav class="footer-links">
		<a href="/politica-de-privacidade">Política de Privacidade</a>
		<a href="/termos-de-uso">Termos de Uso</a>
		<a href="mailto:contato@semnarrativa.com.br">contato@semnarrativa.com.br</a>
	</nav>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		background: var(--bg);
		border-top: 1px solid rgb(var(--border));
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0 0 1em 0;
	}
	.footer-links {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5em 1.5em;
	}
	.footer-links a {
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.9rem;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
</style>