---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Sem <span class="riscado">Narrativa</span></a></h2>
<div class="internal-links">
	<HeaderLink href="/">Home</HeaderLink>
	<HeaderLink href="/blog">Blog</HeaderLink>
	<HeaderLink href="/about">Sobre</HeaderLink>
	<HeaderLink href="/loja">Loja</HeaderLink>
</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #0a0a0f;
		border-bottom: 1px solid rgb(var(--border));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	.riscado {
	position: relative;
}

.riscado::after {
	content: '';
	position: absolute;
	left: -4px;
	right: -4px;
	top: 50%;
	height: 1px;
	background: #fcfbfb;
}

h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links a {
		color: rgb(var(--black));
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
