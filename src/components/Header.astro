---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">Sem <span class="riscado">Narrativa</span></a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">Sobre</HeaderLink>
			<HeaderLink href="/loja">Loja</HeaderLink>
		</div>
		<button
			id="theme-toggle"
			class="theme-toggle"
			type="button"
			aria-label="Alternar entre tema claro e escuro"
		>
			<svg
				class="icon-sun"
				viewBox="0 0 24 24"
				width="20"
				height="20"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="4"></circle>
				<path
					d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
				></path>
			</svg>
			<svg
				class="icon-moon"
				viewBox="0 0 24 24"
				width="20"
				height="20"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
			</svg>
		</button>
	</nav>
</header>
<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const root = document.documentElement;
		const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
		root.setAttribute('data-theme', next);
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
	});
</script>
<style>
	header {
		position: relative;
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid rgb(var(--border));
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}
	.riscado {
		position: relative;
		display: inline-block;
	}
	.riscado::after {
		content: '';
		position: absolute;
		left: -4px;
		right: -4px;
		top: 50%;
		height: 1px;
		background: rgb(var(--black));
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		border: 1px solid rgb(var(--border));
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--black));
		cursor: pointer;
		transition: 0.2s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.theme-toggle .icon-moon {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-toggle .icon-sun {
		display: none;
	}
	:global(:root[data-theme='light']) .theme-toggle .icon-moon {
		display: block;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			align-items: center;
			padding-bottom: 0.25em;
		}
		h2 a {
			display: block;
			padding: 0.9em 0 0.2em 0;
		}
		.internal-links {
			display: flex;
			justify-content: center;
		}
		.internal-links a {
			padding: 0.6em 0.7em;
			font-size: 0.95rem;
		}
		.theme-toggle {
			position: absolute;
			top: 0.7em;
			right: 0.75em;
			width: 36px;
			height: 36px;
		}
	}
</style>