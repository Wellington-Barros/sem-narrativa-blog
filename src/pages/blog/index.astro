---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.category-nav {
				display: flex;
				justify-content: center;
				gap: 1rem;
				padding: 1.5rem 1rem;
				flex-wrap: wrap;
			}
.category-nav a {
	color: rgb(var(--gray-dark));
	text-decoration: none;
	padding: 0.75em 1.75em;
	border: 1px solid rgb(var(--border));
	border-radius: 999px;
	font-size: 1.05rem;
	font-weight: 600;
	transition: 0.2s ease;
}
			.category-nav a:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.category {
				display: inline-block;
				background: rgba(var(--gray-light), 1);
				border: 1px solid rgb(var(--border));
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding: 0.25em 0.75em;
				border-radius: 999px;
				margin-bottom: 0.5rem;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="category-nav">
			{
				CATEGORIES.map((category) => (
					<a href={`/blog/categoria/${category.slug}`}>{category.name}</a>
				))
			}
		</div>
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`}>
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									</a>
								)}
								
								<a	href={`/blog/categoria/${CATEGORIES.find((c) => c.name === post.data.category)?.slug}`}
									class="category"
								>
									{post.data.category}
								</a>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>