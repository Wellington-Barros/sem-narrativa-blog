---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Search from '../../components/Search.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.category-nav {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 2rem auto 2.5rem;
			}
			.category-nav-title {
				margin: 0 0 0.9rem;
				text-align: center;
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}
			.category-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1rem;
			}
			.category-card {
				position: relative;
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				padding: 1.3rem 1.3rem 1.1rem;
				border: 2px solid var(--accent);
				border-radius: 16px;
				background: linear-gradient(145deg, rgba(124, 108, 246, 0.22), rgba(124, 108, 246, 0.05));
				color: rgb(var(--gray-dark));
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
			}
			.category-card:hover {
				transform: translateY(-3px);
				background: linear-gradient(145deg, rgba(124, 108, 246, 0.35), rgba(124, 108, 246, 0.1));
				box-shadow: 0 10px 28px rgba(124, 108, 246, 0.3);
			}
			.category-card-name {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 0.5rem;
				margin: 0;
				font-size: 1.3rem;
				font-weight: 800;
				line-height: 1.2;
				color: rgb(var(--black));
			}
			.category-card-arrow {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 1.9rem;
				height: 1.9rem;
				border-radius: 50%;
				background: var(--accent);
				color: #fff;
				font-size: 1rem;
				transition: transform 0.2s ease;
			}
			.category-card:hover .category-card-arrow {
				transform: translateX(3px);
			}
			.category-card-desc {
				margin: 0;
				font-size: 0.92rem;
				line-height: 1.45;
				color: rgb(var(--gray-dark));
			}
			.category-card-count {
				margin-top: auto;
				padding-top: 0.4rem;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: var(--accent);
			}
			:global(:root[data-theme='light']) .category-card {
				background: linear-gradient(145deg, rgba(91, 75, 212, 0.14), rgba(91, 75, 212, 0.03));
			}
			:global(:root[data-theme='light']) .category-card:hover {
				background: linear-gradient(145deg, rgba(91, 75, 212, 0.22), rgba(91, 75, 212, 0.06));
				box-shadow: 0 10px 28px rgba(91, 75, 212, 0.2);
			}
			@media (max-width: 720px) {
				.category-nav {
					margin: 1.25rem auto 1.75rem;
				}
				.category-grid {
					grid-template-columns: 1fr;
					gap: 0.75rem;
				}
				.category-card {
					padding: 1rem 1.1rem;
				}
				.category-card-name {
					font-size: 1.15rem;
				}
			}
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.category {
				display: inline-block;
				background: rgba(var(--gray-light), 1);
				border: 1px solid rgb(var(--border));
				color: var(--accent);
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				padding: 0.25em 0.75em;
				border-radius: 999px;
				margin-bottom: 0.5rem;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<Search />
		<nav class="category-nav" aria-label="Categorias">
			<p class="category-nav-title">Escolha o tipo de artigo</p>
			<div class="category-grid">
				{
					CATEGORIES.map((category) => {
						const count = posts.filter((post) => post.data.category === category.name).length;
						return (
							<a class="category-card" href={`/blog/categoria/${category.slug}/`}>
								<span class="category-card-name">
									{category.name}
									<span class="category-card-arrow" aria-hidden="true">&rarr;</span>
								</span>
								<span class="category-card-desc">{category.description}</span>
								<span class="category-card-count">
									{count} {count === 1 ? 'artigo' : 'artigos'}
								</span>
							</a>
						);
					})
				}
			</div>
		</nav>
		<main>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								{post.data.heroImage && (
									<a href={`/blog/${post.id}/`}>
										<Image width={720} height={360} src={post.data.heroImage} alt={post.data.title} />
									</a>
								)}
								
								<a	href={`/blog/categoria/${CATEGORIES.find((c) => c.name === post.data.category)?.slug}`}
									class="category"
								>
									{post.data.category}
								</a>
								<a href={`/blog/${post.id}/`}>
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>