---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="pt-BR">
	<head>
		<BaseHead
			title="Loja Sem Narrativa"
			description="A loja do Sem Narrativa está a caminho."
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>Em breve.</h1>
			<p>
				A loja do Sem Narrativa está sendo construída. Em breve você vai poder vestir a ideia
				também.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		text-align: center;
	}
	main {
		text-align: center;
	}
</style>